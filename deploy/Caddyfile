# Plain HTTP on :80. TLS is terminated by the Cloudflare Tunnel (public hostname -> http://<this host>:80).
:80 {
	encode zstd gzip

	# Never serve a stale page from the app's webview cache: the page must be re-checked with Cloudflare Access.
	@pages not path /assets/* /fonts/* /brand/*
	header @pages Cache-Control "no-cache"

	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	# LiveKit signalling (websocket) lives under /lk so one hostname does everything.
	handle_path /lk/* {
		reverse_proxy 127.0.0.1:7880
	}

	# Public share page (link previews). Cloudflare Access bypasses this path; it holds no meeting data.
	handle /s/* {
		rewrite * /s.html
		root * /srv/web
		file_server
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
