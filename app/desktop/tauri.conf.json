{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Irisflow",
  "version": "0.1.0",
  "identifier": "app.irisflow.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["irisflow"] } }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "publisher": "Reach Neo",
    "category": "Productivity",
    "shortDescription": "Free, open source video meetings",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}